#!/usr/bin/env bash
# pre-push hook: validate outgoing commits have normalized messages.
# Install: cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -euo pipefail

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha; do
    # 4 zeros means we're deleting a remote branch - skip
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        continue
    fi

    # Determine the range of commits to validate
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        commits=$(git rev-list --not --remotes "$local_sha" 2>/dev/null || git rev-list "$local_sha")
    else
        commits=$(git rev-list "$remote_sha..$local_sha")
    fi

    failed=0

    while read sha; do
        [[ -z "$sha" ]] && continue
        raw_msg=$(git log -1 --format="%B" "$sha")

        subject=$(echo "$raw_msg" | head -n1)
        subject_len=${#subject}

        # Check 1: subject line length <= 72
        if [[ "$subject_len" -gt 72 ]]; then
            echo "pre-push: commit $sha subject exceeds 72 chars ($subject_len): $subject" >&2
            failed=1
        fi

        # Check 2: no trailing period on subject
        if [[ "$subject" =~ \.$ ]]; then
            echo "pre-push: commit $sha subject has trailing period: $subject" >&2
            failed=1
        fi

        # Check 3: if there is a body, there must be a blank line after the subject
        second_line=$(echo "$raw_msg" | sed -n '2p')
        body_start=$(echo "$raw_msg" | sed -n '3p')

        if [[ -n "$body_start" ]] && [[ -n "$second_line" ]]; then
            echo "pre-push: commit $sha missing blank line between subject and body" >&2
            failed=1
        fi

    done <<< "$commits"

    if [[ "$failed" -ne 0 ]]; then
        echo "pre-push: push rejected due to non-normalized commit messages." >&2
        echo "pre-push: run 'python3 cli.py <message>' to see the normalized form." >&2
        exit 1
    fi
done

exit 0
